# Copy this file to .env.local and fill in your Supabase project values.
# Find them in Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: lets `npm run smoke -- --submit` test /api/send-estimate end to
# end without sending any SMS or email. Any long random string; set the same
# value in Vercel's environment variables to test the live site.
SMOKE_TEST_TOKEN=

# Satellite roof-size suggestion (Google Solar API, buildingInsights).
# Server only; the key should be restricted to the Solar API. Off unless
# SOLAR_AUTOFILL_ENABLED=true. SOLAR_DAILY_LIMIT caps real calls per day
# (Adelaide time), counted in Supabase: run supabase/solar_usage.sql first.
# See docs/solar-autofill-plan.md.
GOOGLE_SOLAR_API_KEY=
SOLAR_AUTOFILL_ENABLED=false
SOLAR_DAILY_LIMIT=50

# Satellite view in both calculators (Google Maps Embed API). Public by
# design: restrict it in Google Cloud to adelaideroofers.com.au (+ www) and
# the Maps Embed API only. If unset, the old keyless embed is used.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
